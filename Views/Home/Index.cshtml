@model IBNB.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Início";
    var domingoHoje = DateTime.Today.DayOfWeek == DayOfWeek.Sunday;
    var quartaHoje = DateTime.Today.DayOfWeek == DayOfWeek.Wednesday;
    var sextaHoje = DateTime.Today.DayOfWeek == DayOfWeek.Friday;
    var classeDomingo = domingoHoje ? "home-semana-linha hoje" : "home-semana-linha";
    var classeQuarta = quartaHoje ? "home-semana-linha hoje" : "home-semana-linha";
    var classeSexta = sextaHoje ? "home-semana-linha hoje" : "home-semana-linha";
}

<section class="home-hero">
    <div class="home-hero-conteudo">
        <img src="~/images/peixe-dourado.png" alt="" class="home-hero-marca" />
        <p class="home-rotulo">Bem-vindo à Betsaida</p>
        <h1 class="home-hero-titulo">Um lugar para pertencer, crer e servir.</h1>
        <p class="home-hero-texto">
            Somos uma comunidade que acolhe, ensina a Palavra e caminha junto.
            Venha nos visitar neste domingo.
        </p>
        <div class="home-hero-acoes">
            <a class="btn btn-primary btn-lg px-4" href="#semana">Nossa semana</a>
        </div>
    </div>

    <a class="home-hero-rolagem" href="#sobre" aria-label="Rolar para conhecer a igreja">
        <span>Conhecer a igreja</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </a>
</section>

@if (Model.Versiculo is not null)
{
    <section class="home-verso-faixa" aria-label="Versículo do dia">
        <p class="home-verso-rotulo">Versículo do dia</p>
        <div class="home-verso-conteudo">
            <blockquote class="home-verso-resumo" data-verso-preview>@Model.Versiculo.Texto</blockquote>
            <p class="home-verso-meta">
                @if (!string.IsNullOrWhiteSpace(Model.Versiculo.Autor))
                {
                    <span class="home-verso-autor">(@Model.Versiculo.Autor)</span>
                }
                @Model.Versiculo.Referencia
                <span class="home-verso-traducao">· @Model.Versiculo.Traducao</span>
            </p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-light home-verso-botao"
                data-bs-toggle="modal" data-bs-target="#modalVerso" data-verso-botao>
            Ler completo
        </button>
    </section>
}

<section id="sobre" class="home-secao">
    <div class="row align-items-center g-4 g-lg-5">
        <div class="col-lg-5">
            <figure class="home-foto">
                <img src="~/images/pastor-familia.jfif" asp-append-version="true"
                     alt="Pastor Fabio Teixeira de Almeida e família" />
            </figure>
        </div>
        <div class="col-lg-7">
            <p class="home-rotulo">Nossa história</p>
            <h2 class="home-titulo">Fé que se vive em comunidade</h2>
            <p class="home-texto">
                A Igreja Batista Nacional Betsaida (IBNB) nasceu do desejo de pregar o evangelho de Cristo e servir à comunidade.
                Ao longo dos anos, temos sido um lugar de acolhimento para famílias que buscam
                esperança, direção e comunhão.
            </p>
            <p class="home-texto">
                Acreditamos no amor ao próximo, no poder da oração e na transformação de vidas
                pela Palavra de Deus. Nossa porta está aberta para você e sua família.
            </p>
            <p class="home-lideranca">
                Pastor presidente: <strong>Fabio Teixeira de Almeida</strong>, ao lado de
                <strong>Patricia de Fátima Gomes Almeida</strong>.
            </p>
        </div>
    </div>
</section>

<section id="semana" class="home-secao">
    <div class="home-secao-cabecalho">
        <p class="home-rotulo">Nossa semana</p>
        <h2 class="home-titulo">Horários dos encontros</h2>
        <p class="home-texto">A porta está aberta em todos eles.</p>
    </div>

    <div class="home-semana-card">
        <div class="@classeDomingo">
            <div class="home-semana-dia">
                <span class="home-semana-dia-nome">Domingo</span>
                @if (domingoHoje) { <span class="home-semana-hoje">Hoje</span> }
            </div>
            <div class="home-semana-conteudo">
                <div class="home-semana-item">
                    <span class="home-semana-hora">09:00</span>
                    <div>
                        <div class="home-semana-nome">EBD</div>
                        <div class="home-semana-desc">Escola Bíblica Dominical</div>
                    </div>
                </div>
                <div class="home-semana-item">
                    <span class="home-semana-hora">19:00</span>
                    <div>
                        <div class="home-semana-nome">Culto de Celebração</div>
                        <div class="home-semana-desc">No 1º domingo do mês, Ceia do Senhor. Nos demais, culto de louvor e adoração.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="@classeQuarta">
            <div class="home-semana-dia">
                <span class="home-semana-dia-nome">Quarta</span>
                @if (quartaHoje) { <span class="home-semana-hoje">Hoje</span> }
            </div>
            <div class="home-semana-conteudo">
                <div class="home-semana-item">
                    <span class="home-semana-hora">19:30</span>
                    <div>
                        <div class="home-semana-nome">Culto de Ensino</div>
                        <div class="home-semana-desc">Estudo da Palavra no meio da semana.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="@classeSexta">
            <div class="home-semana-dia">
                <span class="home-semana-dia-nome">Sexta</span>
                @if (sextaHoje) { <span class="home-semana-hoje">Hoje</span> }
            </div>
            <div class="home-semana-conteudo">
                <div class="home-semana-item">
                    <span class="home-semana-hora">19:30</span>
                    <div>
                        <div class="home-semana-nome">Oração na Igreja</div>
                        <div class="home-semana-desc">Oração pela igreja e pelas famílias.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-convite">
    <p class="home-rotulo">Visite-nos</p>
    <h2 class="home-titulo">Venha nos visitar</h2>
    <p class="home-texto">
        Nossa porta está aberta. Se for a sua primeira vez, chegue alguns minutos antes
        e venha como estiver. No domingo à noite, há culto infantil.
    </p>
    <p class="home-endereco">R. Serra Dourada, 120 - Jardim Panorama, Ipatinga - MG, 35164-235</p>
    <div class="home-convite-acoes">
        <a class="btn btn-primary btn-lg px-4" href="https://maps.app.goo.gl/D5LWFGLXzFWu9rq87" target="_blank" rel="noopener">Como chegar</a>
        <a class="btn btn-outline-light btn-lg px-4" asp-controller="Eventos" asp-action="Index">Próximos eventos</a>
    </div>
</section>

@if (Model.Versiculo is not null)
{
    <div class="modal fade" id="modalVerso" tabindex="-1" aria-labelledby="modalVersoTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white" id="modalVersoTitulo">Versículo do dia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body text-white">
                    <blockquote class="home-verso-texto">@Model.Versiculo.Texto</blockquote>
                    <p class="home-verso-referencia">
                        @if (!string.IsNullOrWhiteSpace(Model.Versiculo.Autor))
                        {
                            <span class="home-verso-autor">(@Model.Versiculo.Autor)</span>
                        }
                        @Model.Versiculo.Referencia
                        <span class="home-verso-traducao">· @Model.Versiculo.Traducao</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
}
