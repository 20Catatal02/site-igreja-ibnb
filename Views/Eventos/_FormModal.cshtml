@model IBNB.ViewModels.EventoViewModel

<div class="modal-header border-secondary">
    <h5 class="modal-title text-white">Novo Evento</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body text-white">
    <form id="formEvento" asp-action="Create" asp-controller="Eventos" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Título e Data -->
        <div class="row mb-3">
            <div class="col-md-8">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DataHora" class="form-label"></label>
                <input asp-for="DataHora" type="datetime-local" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>
        </div>

        <!-- Local e Imagem -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Local" class="form-label"></label>
                <input asp-for="Local" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Local" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Imagem do Evento (Opcional)</label>
                <input type="file" id="inputImagem" name="ImagemUpload" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                <!-- Preview da imagem no Dark Mode -->
                <img id="previewImagem" src="#" alt="Preview" class="img-fluid rounded mt-2 d-none border border-secondary" style="max-height: 100px;" />
            </div>
        </div>

        <!-- Descrição -->
        <div class="mb-3">
            <label asp-for="Descricao" class="form-label"></label>
            <textarea asp-for="Descricao" rows="3" class="form-control bg-dark text-white border-secondary"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <!-- Área de Recorrência -->
        <div class="card bg-secondary bg-opacity-10 border-secondary mb-3 p-3">
            <div class="form-check form-switch mb-3">
                <input asp-for="IsRecorrente" class="form-check-input" type="checkbox" id="chkRecorrente">
                <label class="form-check-label text-white" for="chkRecorrente">Este evento é recorrente?</label>
            </div>

            <!-- Campos Condicionais (Só aparecem se IsRecorrente for true) -->
            <div id="divCamposRecorrencia" class="d-none">
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="TipoRecorrencia" class="form-label"></label>
                        <select asp-for="TipoRecorrencia" id="selTipoRecorrencia" class="form-select bg-dark text-white border-secondary">
                            <option value="Diario">Diário</option>
                            <option value="Semanal">Semanal</option>
                            <option value="Mensal">Mensal</option>
                            <option value="Anual">Anual</option>
                            <option value="Personalizado">Personalizado</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiaDaSemana" class="form-label">Dia da Semana</label>
                        <select asp-for="DiaDaSemana" class="form-select bg-dark text-white border-secondary">
                            <option value="Sunday">Domingo</option>
                            <option value="Monday">Segunda</option>
                            <option value="Tuesday">Terça</option>
                            <option value="Wednesday">Quarta</option>
                            <option value="Thursday">Quinta</option>
                            <option value="Friday">Sexta</option>
                            <option value="Saturday">Sábado</option>
                        </select>
                    </div>
                </div>

                <!-- Campos Extras para "Personalizado" -->
                <div id="divPersonalizado" class="row d-none mt-2">
                    <div class="col-md-6">
                        <label asp-for="FrequenciaPersonalizada" class="form-label"></label>
                        <select asp-for="FrequenciaPersonalizada" class="form-select bg-dark text-white border-secondary">
                            <option value="dia">A cada dia(s)</option>
                            <option value="semana">A cada semana(s)</option>
                            <option value="mes">A cada mês(es)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IntervaloRecorrencia" class="form-label">Intervalo</label>
                        <input asp-for="IntervaloRecorrencia" type="number" min="1" value="1" class="form-control bg-dark text-white border-secondary" />
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer border-secondary px-0 pb-0">
            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar Evento</button>
        </div>
    </form>
</div>