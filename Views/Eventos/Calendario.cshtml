@model IEnumerable<IBNB.ViewModels.CalendarioItemViewModel>

@{
    ViewData["Title"] = "Calendário Unificado";
}

<div class="container my-4">
    <h2 class="mb-4 text-primary">Calendário Unificado</h2>
    <p class="text-muted">Acompanhe feriados nacionais, eventos da igreja e aniversariantes integrados.</p>

    <div class="card shadow border-0 p-4">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Data</th>
                    <th>Título / Descrição</th>
                    <th>Categoria</th>
                    <th>Local</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Nenhum registo encontrado para este período.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Data.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold">@item.Titulo</td>
                            <td>
                                @if (item.Categoria == "Feriado")
                                {
                                    <span class="badge bg-danger">Feriado</span>
                                }
                                else if (item.Categoria == "Aniversário")
                                {
                                    <span class="badge bg-warning text-dark">Aniversário</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Igreja</span>
                                }
                            </td>
                            <td>@item.Local</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Voltar para Eventos</a>
    </div>
</div>