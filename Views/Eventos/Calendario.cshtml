@model IBNB.ViewModels.CalendarioViewModel
@{
    ViewData["Title"] = "Eventos";
    var culture = new System.Globalization.CultureInfo("pt-BR");
    var diasSemana = new[] { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" };

    var corEvento = "#198754";
    var corFeriado = "#dc3545";
    var corAniversario = "#fd7e14";
    var corCeia = "#facc15";

    var itensDoMes = Model.Dias
        .SelectMany(dia => dia.Itens)
        .ToList();

    var cultosFixosNoMes = itensDoMes.Count(item =>
        item.Categoria == "Evento" &&
        !item.Destaque &&
        string.IsNullOrWhiteSpace(item.Departamento));

    var ceiasNoMes = itensDoMes.Count(item => item.Destaque);
    var feriadosNoMes = itensDoMes.Count(item => item.Categoria == "Feriado");
    var aniversariantesNoMes = itensDoMes.Count(item => item.Categoria == "Aniversário");

    var homensNoMes = itensDoMes.Count(item =>
        string.Equals(item.Departamento, "Homens", StringComparison.OrdinalIgnoreCase));
    var mulheresNoMes = itensDoMes.Count(item =>
        string.Equals(item.Departamento, "Mulheres", StringComparison.OrdinalIgnoreCase));
    var jovensNoMes = itensDoMes.Count(item =>
        string.Equals(item.Departamento, "Jovens", StringComparison.OrdinalIgnoreCase));

    var mesAnterior = Model.PrimeiroDia.AddMonths(-1);
    var mesSeguinte = Model.PrimeiroDia.AddMonths(1);
    var vaziosIniciais = (int)Model.PrimeiroDia.DayOfWeek;

    // Estamos no mês corrente (hoje)?
    var mesCorrente = Model.Mes == Model.Hoje.Month && Model.Ano == Model.Hoje.Year;


}

<style>
    .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }
    .cal-head {
        text-align: center;
        font-weight: 700;
        font-size: .8rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #9aa4ae;
        padding-bottom: .35rem;
    }
    .cal-hoje {
        border-left: 3px solid rgba(212, 175, 55, .8);
    }
    .cal-hoje-rotulo {
        color: #d4af37;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
        margin-bottom: .4rem;
    }
    .cal-hoje-data {
        color: #fff;
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 1rem;
    }
    .cal-hoje-data::first-letter {
        text-transform: uppercase;
    }
    .cal-hoje-proximo {
        padding-left: 1.5rem;
        border-left: 1px solid #2a3037;
    }
    @@media (max-width: 767.98px) {
        .cal-hoje-proximo {
            padding-left: 0;
            border-left: 0;
            padding-top: 1rem;
            border-top: 1px solid #2a3037;
        }
    }
    .cal-cabecalho {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .75rem;
    }
    .cal-cabecalho-mes {
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .cal-cabecalho-mes h5 {
        margin: 0;
        font-size: 1.1rem;
    }
    .cal-cabecalho-mes h5::first-letter {
        text-transform: uppercase;
    }
    .cal-cell {
        aspect-ratio: 1 / 1;
        border: 1px solid #3a3f45;
        border-radius: .5rem;
        background-color: #212529;
        padding: .35rem .4rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: border-color .2s ease, transform .2s ease;
    }
    .cal-cell:hover {
        border-color: #0d6efd;
        transform: translateY(-2px);
    }
    .cal-cell.vazio {
        background-color: transparent;
        border: 1px dashed #2c3136;
    }
    .cal-cell.hoje {
        border: 2px solid #0d6efd;
        background-color: #1b2a3d;
    }
    /* Dia aberto no modal: fica acima do véu com menos desfoque e leve escurecimento */
    .cal-cell.selecionado {
        position: relative;
        z-index: 1051;
        border-color: rgba(77, 159, 255, .65);
        background-color: #1b2a3d;
        filter: blur(1.1px) brightness(.92);
        transition: border-color .2s ease, background-color .2s ease;
    }
    .cal-cell.selecionado::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background-color: rgba(10, 12, 14, .28);
        pointer-events: none;
    }
    .cal-numero {
        font-weight: 700;
        font-size: .95rem;
        color: #e0e0e0;
        line-height: 1;
    }
    .cal-cell.hoje .cal-numero {
        color: #4da3ff;
    }
    .cal-itens {
        margin-top: .3rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
    }
    .cal-item {
        font-size: .68rem;
        line-height: 1.15;
        color: #fff;
        border-radius: 3px;
        padding: 1px 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* Tarja de destaque: Ceia do Senhor e Virada de Ano (amarelo) */
    .cal-item.ceia {
        background-image: repeating-linear-gradient(
            45deg,
            @corCeia,
            @corCeia 6px,
            #eab308 6px,
            #eab308 12px);
        color: #1a1a1a !important;
        font-weight: 700;
        border-left: 3px solid #a16207;
        box-shadow: 0 0 0 1px #a16207 inset;
    }
    .cal-item.ceia::before {
        content: "★ ";
    }
    .cal-mais {
        font-size: .65rem;
        color: #9aa4ae;
    }
    .cal-legenda span.dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
    }
    .cal-legenda-item {
        display: inline-flex;
        align-items: center;
    }
    /* Faixa do bloco "Hoje" para Ceia / Virada de ano */
    .faixa-ceia {
        background-image: repeating-linear-gradient(45deg, @corCeia, @corCeia 6px, #eab308 6px, #eab308 12px);
        color: #1a1a1a;
        font-weight: 700;
        border-left: 3px solid #a16207;
    }
    /* Lista "Nossa agenda": apenas um pequeno risco na cor do evento */
    .agenda-item {
        font-size: .82rem;
        color: #fff;
        padding-left: .6rem;
        border-left: 3px solid transparent;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .agenda-item.verde {
        border-left-color: @corEvento;
    }
    .agenda-item.amarelo {
        border-left-color: @corCeia;
    }
    /* Marcadores coloridos dentro da célula (visíveis também no celular) */
    .cal-marcadores {
        margin-top: .2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
    }
    .cal-marcador {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .cal-marcador.mais {
        width: auto;
        height: auto;
        border-radius: 3px;
        background-color: #495057 !important;
        color: #fff;
        font-size: .55rem;
        line-height: 1;
        padding: 1px 3px;
    }
    .cal-cell.tem-itens {
        cursor: pointer;
    }
    .cal-cell:focus-visible {
        outline: 2px solid #4da3ff;
        outline-offset: 2px;
    }
    .cal-detalhe {
        display: none;
    }

    /* Faixa de resumo do mês */
    .cal-resumo {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem .9rem;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: .5rem .75rem;
        border: 1px solid #3a3f45;
        border-radius: .5rem;
        background-color: #212529;
        color: #e0e0e0;
        font-size: .8rem;
    }
    .cal-resumo-legenda {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .35rem .9rem;
    }
    .cal-legenda-item strong {
        color: #fff;
        margin-left: .18rem;
    }
    .cal-dia-semana {
        font-size: .6rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #6c757d;
        line-height: 1;
        margin-top: 1px;
    }
    .cal-cell.hoje .cal-dia-semana {
        color: #4da3ff;
    }

    /* Fundo do modal: escurece e desfoca o calendário */
    .modal-backdrop.show {
        opacity: 1;
        background-color: rgba(8, 10, 12, .66);
        backdrop-filter: blur(7px) saturate(.85);
        -webkit-backdrop-filter: blur(7px) saturate(.85);
    }

    /* Itens do modal (zoom do dia) */
    .detalhe-linha {
        border-left: 4px solid #6c757d;
        padding: .4rem .6rem;
        margin-bottom: .5rem;
        background-color: #212529;
        border-radius: 0 .35rem .35rem 0;
    }
    .detalhe-linha.ceia {
        border-left-color: #facc15;
        background-image: repeating-linear-gradient(45deg, rgba(250, 204, 21, .12), rgba(250, 204, 21, .12) 6px, rgba(234, 179, 8, .18) 6px, rgba(234, 179, 8, .18) 12px);
    }

    /* Celular: esconde o texto do evento e prioriza os marcadores + modal */
    @@media (max-width: 575.98px) {
        .cal-grid {
            gap: 3px;
        }
        .cal-head {
            font-size: .6rem;
            letter-spacing: 0;
        }
        .cal-cell {
            padding: .2rem .25rem;
            border-radius: .35rem;
        }
        .cal-numero {
            font-size: .8rem;
        }
        .cal-itens {
            display: none;
        }
        .cal-marcador {
            width: 7px;
            height: 7px;
        }
    }

    /* Telas maiores: mantém os marcadores discretos */
    @@media (min-width: 576px) {
        .cal-marcadores {
            display: none;
        }

        /* Desktop: encolhe a faixa de resumo ao conteúdo e centraliza o bloco,
           eliminando o espaço vago à esquerda e à direita.
           (No mobile a faixa continua ocupando a largura toda.) */
        .cal-resumo {
            width: fit-content;
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
            gap: .35rem 1.15rem;
            padding: .45rem 1.1rem;
        }
    }
</style>

<div class="container mt-4 mb-5">

    <div class="row g-3 mb-4">
        <!-- Bloco HOJE -->
        <div class="col-12">
            <div class="card cal-hoje bg-dark border-secondary h-100">
                <div class="card-body">
                    <div class="row g-4 align-items-start">
                        <div class="col-md-7">
                            <div class="cal-hoje-rotulo">Hoje</div>
                            <div class="cal-hoje-data">
                                @Model.Hoje.ToString("dddd, dd 'de' MMMM 'de' yyyy", culture)
                            </div>

                            <div class="mb-0">
                                <span class="text-white-50 small fw-bold text-uppercase">Culto / Eventos:</span>
                                @if (Model.TemCultoHoje)
                                {
                                    foreach (var ev in Model.EventosHoje)
                                    {
                                        if (ev.Destaque)
                                        {
                                            <div class="d-inline-block me-2 mb-1 px-2 py-1 rounded faixa-ceia">
                                                <span class="small">@ev.Data.ToString("HH:mm") — @ev.Titulo</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-inline-block me-2 mb-1 px-2 py-1 rounded" style="background-color:@ev.Cor;">
                                                <span class="text-white small fw-semibold">@ev.Data.ToString("HH:mm") — @ev.Titulo</span>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-white-50">Sem culto ou evento hoje.</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-5 cal-hoje-proximo">
                            <div class="mb-2">
                                <span class="text-white-50 small fw-bold text-uppercase">Próximo evento:</span>
                                @if (Model.ProximoEvento != null)
                                {
                                    var dias = (Model.ProximoEvento.Data.Date - Model.Hoje.Date).Days;
                                    <span class="text-white">
                                        @Model.ProximoEvento.Data.ToString("dd/MM/yyyy", culture) às @Model.ProximoEvento.Data.ToString("HH:mm")
                                        — @Model.ProximoEvento.Titulo
                                        <span class="badge bg-secondary ms-1">
                                            @(dias == 0 ? "hoje" : dias == 1 ? "amanhã" : $"em {dias} dias")
                                        </span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-white-50">Nenhum evento programado nos próximos meses.</span>
                                }
                            </div>

                            @if (Model.FeriadosHoje.Any())
                            {
                                <div>
                                    <span class="text-white-50 small fw-bold text-uppercase">Feriado:</span>
                                    @foreach (var f in Model.FeriadosHoje)
                                    {
                                        <div class="d-inline-block me-2 mb-1 px-2 py-1 rounded" style="background-color:@corFeriado;">
                                            <span class="text-white small fw-semibold">@f.Titulo</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>



    </div>

    <!-- Grade do calendário (somente o mês exibido) -->
    <div class="card bg-dark border-secondary">
        <div class="card-body p-2 p-md-3">
            <div class="cal-cabecalho">
                <div class="cal-cabecalho-mes">
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Calendario"
                       asp-route-mes="@mesAnterior.Month" asp-route-ano="@mesAnterior.Year">&laquo;</a>
                    <h5 class="text-white mb-0">@Model.NomeMes</h5>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Calendario"
                       asp-route-mes="@mesSeguinte.Month" asp-route-ano="@mesSeguinte.Year">&raquo;</a>
                </div>
                @if (!mesCorrente)
                {
                    <a class="btn btn-outline-primary btn-sm" asp-action="Calendario">Ir para hoje</a>
                }
            </div>

            <div class="cal-resumo mb-3">
                <div class="cal-resumo-legenda cal-legenda text-white-50 small">
                    @if (cultosFixosNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:@corEvento;"></span>Cultos regulares: <strong>@cultosFixosNoMes</strong></span>
                    }
                    @if (ceiasNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:@corCeia;"></span>Ceia: <strong>@ceiasNoMes</strong></span>
                    }
                    @if (feriadosNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:@corFeriado;"></span>@(feriadosNoMes == 1 ? "Feriado" : "Feriados"): <strong>@feriadosNoMes</strong></span>
                    }
                    @if (Model.MostrarAniversariantes && aniversariantesNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:@corAniversario;"></span>@(aniversariantesNoMes == 1 ? "Aniversário" : "Aniversários"): <strong>@aniversariantesNoMes</strong></span>
                    }
                    @if (homensNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:#1e3a8a;"></span>Homens: <strong>@homensNoMes</strong></span>
                    }
                    @if (mulheresNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:#ec4899;"></span>Mulheres: <strong>@mulheresNoMes</strong></span>
                    }
                    @if (jovensNoMes > 0)
                    {
                        <span class="cal-legenda-item"><span class="dot" style="background-color:#8b5cf6;"></span>Jovens: <strong>@jovensNoMes</strong></span>
                    }
                </div>
            </div>

            <div class="cal-grid">
                @foreach (var dia in diasSemana)
                {
                    <div class="cal-head">@dia</div>
                }

                @for (int v = 0; v < vaziosIniciais; v++)
                {
                    <div class="cal-cell vazio"></div>
                }

                @foreach (var d in Model.Dias)
                {
                    var classes = "cal-cell";
                    if (d.EhHoje) { classes += " hoje"; }
                    if (d.Itens.Any()) { classes += " tem-itens"; }

                    var diaLongo = d.Data.ToString("dddd, dd 'de' MMMM 'de' yyyy", culture);

                    <div class="@classes" role="button" tabindex="0"
                         data-bs-toggle="modal" data-bs-target="#modalDia"
                         data-dia="@d.Data.ToString("dd/MM/yyyy")"
                         data-dia-longo="@diaLongo">
                        <div class="cal-numero">@d.Data.Day</div>
                        <div class="cal-dia-semana">@d.DiaSemana</div>

                        @* Marcadores coloridos: aparecem em qualquer tela, mesmo no celular *@
                        <div class="cal-marcadores">
                            @foreach (var item in d.Itens.Take(5))
                            {
                                var corMarcador = item.Destaque ? corCeia
                                        : item.Categoria == "Feriado" ? corFeriado
                                        : item.Categoria == "Aniversário" ? corAniversario
                                        : item.Cor;
                                <span class="cal-marcador" style="background-color:@corMarcador;"></span>
                            }
                            @if (d.Itens.Count > 5)
                            {
                                <span class="cal-marcador mais">+@(d.Itens.Count - 5)</span>
                            }
                        </div>

                        @* Texto do evento: visível apenas em telas maiores *@
                        <div class="cal-itens">
                            @foreach (var item in d.Itens.Take(3))
                            {
                                var texto = item.Rotulo;

                                if (item.Destaque)
                                {
                                    <div class="cal-item ceia" title="@texto">@texto</div>
                                }
                                else
                                {
                                    var cor = item.Categoria == "Feriado" ? corFeriado
                                            : item.Categoria == "Aniversário" ? corAniversario
                                            : item.Cor;
                                    <div class="cal-item" style="background-color:@cor;" title="@texto">@texto</div>
                                }
                            }
                            @if (d.Itens.Count > 3)
                            {
                                <div class="cal-mais">+@(d.Itens.Count - 3) mais</div>
                            }
                        </div>

                        @* Conteúdo completo consumido pelo modal (zoom do dia) *@
                        <div class="cal-detalhe">
                            @if (!d.Itens.Any())
                            {
                                <p class="text-white-50 mb-0">Nenhum evento, feriado ou aniversário neste dia.</p>
                            }
                            else
                            {
                                foreach (var item in d.Itens)
                                {
                                    <div class="detalhe-linha @(item.Destaque ? "ceia" : "")"
                                         style="@(item.Destaque ? "" : $"border-left-color:{(item.Categoria == "Feriado" ? corFeriado : item.Categoria == "Aniversário" ? corAniversario : item.Cor)};")">
                                        <div class="fw-semibold text-white">
                                            @if (item.Categoria == "Evento")
                                            {
                                                <span class="text-white-50 me-1">@item.Data.ToString("HH:mm")</span>
                                            }
                                            @item.Rotulo
                                        </div>
                                        <div class="small text-white-50">
                                            @item.Categoria
                                            @if (!string.IsNullOrWhiteSpace(item.Local) && item.Local != "-")
                                            {
                                                @: · @item.Local
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>

</div>

<!-- Modal: zoom do dia -->
<div class="modal fade" id="modalDia" tabindex="-1" aria-labelledby="modalDiaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white text-capitalize" id="modalDiaTitulo">Dia</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body text-white" id="modalDiaCorpo">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalDia = document.getElementById('modalDia');
            if (!modalDia) { return; }

            modalDia.addEventListener('show.bs.modal', function (event) {
                var celula = event.relatedTarget;
                if (!celula) { return; }

                document.querySelectorAll('.cal-cell.selecionado').forEach(function (item) {
                    item.classList.remove('selecionado');
                });
                celula.classList.add('selecionado');

                var titulo = modalDia.querySelector('#modalDiaTitulo');
                var corpo = modalDia.querySelector('#modalDiaCorpo');
                var diaLongo = celula.getAttribute('data-dia-longo') || celula.getAttribute('data-dia');

                titulo.textContent = diaLongo;
                corpo.innerHTML = '';

                var detalhe = celula.querySelector('.cal-detalhe');
                if (detalhe) {
                    corpo.innerHTML = detalhe.innerHTML;
                }
            });

            modalDia.addEventListener('hidden.bs.modal', function () {
                document.querySelectorAll('.cal-cell.selecionado').forEach(function (item) {
                    item.classList.remove('selecionado');
                });
            });

            // Acessibilidade: abrir com Enter/Espaço pelo teclado
            document.querySelectorAll('.cal-cell[data-bs-toggle]').forEach(function (celula) {
                celula.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        celula.click();
                    }
                });
            });
        })();
    </script>
}
