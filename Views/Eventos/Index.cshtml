@model IBNB.ViewModels.EventosIndexViewModel

@{
    ViewData["Title"] = "Eventos";

    var corEvento = "#198754";
    var corCeia = "#facc15";
    var culture = new System.Globalization.CultureInfo("pt-BR");

    var coresLinha = Model.Tipos.Select(t => t.Cor).ToList();
    var paradasLinha = new List<string> { "transparent 0%" };

    if (coresLinha.Count == 1)
    {
        paradasLinha.Add($"{coresLinha[0]} 12%");
        paradasLinha.Add($"{coresLinha[0]} 88%");
    }
    else if (coresLinha.Count > 1)
    {
        for (int i = 0; i < coresLinha.Count; i++)
        {
            var pct = 6 + (i * 88.0 / (coresLinha.Count - 1));
            paradasLinha.Add($"{coresLinha[i]} {pct:0.#}%");
        }
    }

    paradasLinha.Add("transparent 100%");
    var gradienteLinha = $"linear-gradient(to bottom, {string.Join(", ", paradasLinha)})";
    var corFim = coresLinha.LastOrDefault() ?? "#198754";
}

<style>
    /* ===== Vitrine de eventos: layout alternado (scrollytelling) ===== */
    .ev-hero {
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .ev-hero h1 {
        font-weight: 800;
        letter-spacing: -.02em;
        color: #fff;
        margin-bottom: .75rem;
    }
    .ev-hero p {
        color: #9aa4ae;
        max-width: 620px;
        margin: 0 auto 1.75rem;
        font-size: 1.02rem;
    }
    .ev-acoes {
        display: inline-flex;
        gap: .6rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* Linha do "scrollytelling" */
    .ev-trilha {
        position: relative;
        padding-bottom: 0;
    }
    /* Linha vertical central (desktop).
       A cor segue a mesma logica do calendario:
         verde   = evento comum
         amarelo = Ceia do Senhor / Virada de Ano
         vermelho = feriado (somente quando houver feriado no periodo)
       O vermelho NAO e fixo: o gradiente abaixo cobre apenas verde e amarelo,
       e a classe .tem-feriado acrescenta o vermelho. */
    .ev-trilha::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 3px;
        transform: translateX(-50%);
        border-radius: 3px;
        background: var(--ev-linha, linear-gradient(to bottom, transparent 0%, #198754 12%, #198754 88%, transparent 100%));
        opacity: .45;
        transition: opacity 2.2s cubic-bezier(.16, .84, .44, 1);
    }
    .ev-trilha:hover::before {
        opacity: .75;
    }

    .ev-bloco {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        align-items: center;
        margin-bottom: 3rem;
    }

    /* Marcador na linha central */
    .ev-ponto {
        display: none;
    }

    .ev-card {
        background-color: #212529;
        border: 1px solid #3a3f45;
        border-radius: .9rem;
        padding: 1.6rem 1.7rem;
        transition: border-color .25s ease, transform .25s ease;
    }
    .ev-card:hover {
        border-color: #198754;
        transform: translateY(-3px);
    }
    .ev-card.destaque {
        border-color: #a16207;
        box-shadow: 0 0 0 1px rgba(250, 204, 21, .35) inset;
        background-image: repeating-linear-gradient(45deg,
            rgba(250, 204, 21, .05),
            rgba(250, 204, 21, .05) 8px,
            rgba(234, 179, 8, .09) 8px,
            rgba(234, 179, 8, .09) 16px);
    }

    .ev-tag {
        display: inline-block;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        padding: .22rem .6rem;
        border-radius: 999px;
        background-color: var(--ev-cor, #198754);
        color: #fff;
        border: 1px solid transparent;
        margin-bottom: .7rem;
    }
    .ev-card.destaque .ev-tag {
        background-color: var(--ev-cor, #facc15);
        color: #1a1a1a;
        border-color: transparent;
    }

    .ev-titulo {
        font-size: 1.35rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: .55rem;
        line-height: 1.25;
    }
    .ev-desc {
        color: #adb5bd;
        font-size: .93rem;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .ev-meta {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        font-size: .86rem;
        color: #ced4da;
    }
    .ev-meta-linha {
        display: flex;
        align-items: flex-start;
        gap: .5rem;
    }
    .ev-meta-icone {
        color: #198754;
        flex: 0 0 1rem;
        font-weight: 700;
    }
    .ev-card.destaque .ev-meta-icone {
        color: #facc15;
    }

    /* "Próximo" como selo */
    .ev-proximo {
        display: inline-block;
        margin-top: .9rem;
        font-size: .78rem;
        font-weight: 600;
        padding: .3rem .7rem;
        border-radius: .45rem;
        background-color: rgba(13, 110, 253, .15);
        border: 1px solid rgba(13, 110, 253, .45);
        color: #6ea8fe;
    }

    /* Painel lateral (o "vazio" do layout alternado, preenchido com um detalhe) */
    .ev-lateral {
        display: none;
    }
    /* Mobile/tablet: a data aparece dentro do card */
    .ev-data::first-letter {
        text-transform: uppercase;
    }

    /* ===== Desktop: alterna esquerda / direita ===== */
    @@media (min-width: 768px) {
        .ev-bloco {
            grid-template-columns: 1fr 84px 1fr;
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }
        .ev-ponto {
            display: flex;
            justify-content: center;
            align-items: center;
            grid-column: 2;
            grid-row: 1;
        }
        .ev-ponto span {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background-color: var(--ev-cor, #198754);
            box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px #3a3f45;
            transition: background-color .5s cubic-bezier(.22, .61, .36, 1), box-shadow .5s cubic-bezier(.22, .61, .36, 1), transform .5s cubic-bezier(.22, .61, .36, 1);
        }
        .ev-bloco.destaque .ev-ponto span {
            background-color: #facc15;
            box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px #a16207;
        }

        /* Blocos ímpares: card à esquerda, detalhe à direita */
        .ev-bloco:nth-of-type(odd) .ev-card { grid-column: 1; grid-row: 1; }
        .ev-bloco:nth-of-type(odd) .ev-lateral {
            grid-column: 3;
            grid-row: 1;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 1.5rem;
        }

        /* Blocos pares: card à direita, detalhe à esquerda */
        .ev-bloco:nth-of-type(even) .ev-card { grid-column: 3; grid-row: 1; }
        .ev-bloco:nth-of-type(even) .ev-lateral {
            grid-column: 1;
            grid-row: 1;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-right: 1.5rem;
        }
    }

    /* ===== Microinterações ===== */

    /* Cor de destaque de cada bloco (verde normal, amarelo para Ceia/Virada) */
    .ev-bloco {
        --ev-cor: #198754;
        --ev-tempo: 1.9s;
        --ev-curva: cubic-bezier(.16, .84, .44, 1);
    }
    .ev-bloco.destaque {
        --ev-cor: #facc15;
    }

    /* Linha central: somente no desktop. No mobile nao existe linha central,
       portanto o realce nunca deve ser desenhado sobre o card. */
    .ev-bloco::after {
        content: none;
    }
    .ev-bloco:hover::after {
        content: none;
    }

    @@media (min-width: 768px) {
        /* O trecho aceso da linha central cresce devagar, acompanhando o bloco
           sob o mouse. */
        .ev-bloco::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 3px;
            transform: translateX(-50%) scaleY(.3);
            transform-origin: center;
            background-color: var(--ev-cor);
            opacity: 0;
            transition:
                opacity var(--ev-tempo) var(--ev-curva),
                transform var(--ev-tempo) var(--ev-curva),
                background-color var(--ev-tempo) var(--ev-curva);
            pointer-events: none;
        }
        .ev-bloco:hover::after {
            content: "";
            opacity: .38;
            transform: translateX(-50%) scaleY(1);
        }
    }

    /* Transicao da luz do ponto central: longa e continua, para o dia anterior
       apagar aos poucos enquanto o novo acende. */
    /* O ponto tambem apaga devagar: a luminosidade do card anterior se
       dissolve enquanto o proximo acende, sem corte visual. */
    .ev-ponto span {
        transition:
            background-color 2.6s cubic-bezier(.4, 0, .2, 1),
            box-shadow 2.6s cubic-bezier(.4, 0, .2, 1),
            transform 2.6s cubic-bezier(.4, 0, .2, 1);
    }

    .ev-bloco:hover .ev-ponto span {
        background-color: var(--ev-cor, #4ade80);
        box-shadow:
            0 0 0 5px #1b1f23,
            0 0 0 6px var(--ev-cor),
            0 0 14px 3px rgba(255, 255, 255, .18);
        transform: scale(1.12);
    }

    /* Card: a luz sobe e desce no mesmo ritmo, sem salto ao trocar de card.
       A saida (estado normal) e propositalmente longa para o brilho
       se dissolver aos poucos enquanto o proximo card acende. */
    .ev-card {
        transition:
            border-color 2.8s cubic-bezier(.4, 0, .2, 1),
            transform 2.8s cubic-bezier(.4, 0, .2, 1),
            box-shadow 2.8s cubic-bezier(.4, 0, .2, 1);
    }
    .ev-bloco:hover .ev-card {
        border-color: var(--ev-cor);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, .38);
        transition:
            border-color 1.4s cubic-bezier(.4, 0, .2, 1),
            transform 1.4s cubic-bezier(.4, 0, .2, 1),
            box-shadow 1.4s cubic-bezier(.4, 0, .2, 1);
    }

    /* Marco lateral tambem responde no mesmo tempo */
    .ev-marco-dia {
        transition: color 2.6s cubic-bezier(.4, 0, .2, 1);
    }
    .ev-marco-linha {
        transition:
            width var(--ev-tempo) var(--ev-curva),
            background-color var(--ev-tempo) var(--ev-curva),
            opacity var(--ev-tempo) var(--ev-curva);
    }
    .ev-bloco:hover .ev-marco-dia {
        color: #fff;
    }
    .ev-bloco:hover .ev-marco-linha {
        width: 56px;
        background-color: var(--ev-cor);
        opacity: .85;
    }

    /* ===== Marco visual lateral ===== */
    .ev-marco {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .1rem;
        user-select: none;
    }
    .ev-marco-dia {
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1;
        color: #495057;
        letter-spacing: -.03em;
    }
    .ev-marco-mes {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #6c757d;
    }
    .ev-marco-linha {
        display: block;
        width: 32px;
        height: 2px;
        margin-top: .55rem;
        border-radius: 2px;
        background-color: #343a40;
        opacity: .7;
    }

    /* Rótulos de metadados */
    .ev-meta-rotulo {
        flex: 0 0 3.6rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: #6c757d;
        padding-top: .1rem;
    }
    .ev-agora {
        margin-left: .35rem;
        font-size: .78rem;
        font-weight: 700;
        color: #4ade80;
    }

    /* ===== Mobile: zoom e foco por toque (persistente) ===== */
    @@media (max-width: 767.98px) {
        /* Mais area livre entre os cards: espaco para tocar fora e limpar o foco */
        .ev-bloco {
            margin-bottom: 3.9rem;
        }

        .ev-card {
            transition:
                transform .35s cubic-bezier(.22, .61, .36, 1),
                border-color .35s ease,
                box-shadow .35s ease,
                opacity .35s ease,
                filter .35s ease;
        }

        /* Card selecionado por toque: zoom discreto e nitido */
        .ev-bloco.ev-selecionado .ev-card {
            transform: scale(1.06);
            border-color: var(--ev-cor);
            box-shadow: 0 10px 26px rgba(0, 0, 0, .45);
        }

        /* Enquanto houver um card selecionado, os demais ficam opacos e
           desfocados. O estado permanece ate o usuario tocar fora do card. */
        .ev-trilha.ev-tem-selecao .ev-bloco {
            filter: blur(1.5px) brightness(.55) saturate(.8);
            transition: filter .35s ease;
        }
        .ev-trilha.ev-tem-selecao .ev-bloco.ev-selecionado {
            filter: none;
        }

        /* No toque, o card so ganha borda quando for selecionado de fato.
           Evita o realce de hover durante o toque longo. */
        .ev-bloco:not(.ev-selecionado):hover .ev-card,
        .ev-bloco:not(.ev-selecionado) .ev-card:hover {
            border-color: #3a3f45;
            transform: none;
            box-shadow: none;
        }
        .ev-bloco:not(.ev-selecionado):hover .ev-card.destaque {
            border-color: #a16207;
        }

        /* Nao selecionar texto ao tocar no card */
        .ev-card {
            -webkit-user-select: none;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
    }

    @@media (hover: hover) and (min-width: 768px) {
        .ev-bloco {
            transition: filter .35s ease;
        }

        /* Desktop: o card sob o mouse acende e os demais escurecem,
           sem usar opacity, para a linha central nao atravessar os cards. */
        .ev-trilha:has(.ev-bloco:hover) .ev-bloco {
            filter: blur(1.5px) brightness(.55) saturate(.8);
        }

        .ev-trilha:has(.ev-bloco:hover) .ev-bloco:hover {
            filter: none;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ev-card,
        .ev-bloco::after,
        .ev-marco-dia,
        .ev-marco-linha,
        .ev-ponto span {
            transition: none;
        }
        .ev-bloco:hover .ev-card {
            transform: none;
        }
    }

    .ev-fim {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.35rem;
        padding: 3.2rem 0 0;
    }
    .ev-fim-ponto {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background-color: var(--ev-cor);
        box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px var(--ev-cor);
    }
    .ev-fim .btn {
        border-color: #3a3f45;
    }
    .ev-fim .btn:hover {
        border-color: var(--ev-cor);
    }

    .ev-vazio {
        text-align: center;
        padding: 4rem 1rem;
        color: #9aa4ae;
    }
</style>

<div class="container">

    <!-- Cabeçalho -->
    <section class="ev-hero">
        <h1>Eventos da Igreja</h1>
        <p>
            Conheça as programações dos próximos 15 dias.
            Cada uma aparece uma única vez.
        </p>
        <div class="ev-acoes">
            <a asp-action="Calendario" class="btn btn-primary px-4">Calendário</a>
            @if (Model.PodeCriarEvento)
            {
                <a asp-action="Create" class="btn btn-success px-4">Novo Evento</a>
            }
        </div>
    </section>

    @if (!Model.Tipos.Any())
    {
        <div class="ev-vazio">
            <h4 class="text-white">Nenhuma programação cadastrada</h4>
            <p class="mb-3">Assim que os eventos forem adicionados, eles aparecerão aqui.</p>
            <a asp-action="Calendario" class="btn btn-primary px-4">Ver calendário</a>
        </div>
    }
    else
    {
        <div class="ev-trilha" style="--ev-linha: @gradienteLinha;">
            @foreach (var tipo in Model.Tipos)
            {
                var diasParaProximo = tipo.ProximaData.HasValue
                    ? (tipo.ProximaData.Value.Date - Model.Hoje.Date).Days
                    : (int?)null;

                <div class="ev-bloco @(tipo.Destaque ? "destaque" : "")" style="--ev-cor: @tipo.Cor;">

                    <!-- Card do evento -->
                    <div class="ev-card @(tipo.Destaque ? "destaque" : "")">
                        <span class="ev-tag">@tipo.Tag</span>

                        <h3 class="ev-titulo">@tipo.Titulo</h3>

                        @if (!string.IsNullOrWhiteSpace(tipo.Descricao))
                        {
                            <p class="ev-desc">@tipo.Descricao</p>
                        }
                        else
                        {
                            <p class="ev-desc fst-italic text-white-50">
                                Uma programação especial da nossa igreja.
                            </p>
                        }

                        <div class="ev-meta">
                            <div class="ev-meta-linha">
                                <span class="ev-meta-rotulo">Data</span>
                                <span class="ev-data">
                                    @tipo.DataHora.ToString("dddd, dd 'de' MMMM", culture)
                                    @if (tipo.DataHora.Date == Model.Hoje.Date)
                                    {
                                        <strong class="ev-agora">hoje</strong>
                                    }
                                    else if (tipo.DataHora.Date == Model.Hoje.Date.AddDays(1))
                                    {
                                        <strong class="ev-agora">amanhã</strong>
                                    }
                                </span>
                            </div>
                            <div class="ev-meta-linha">
                                <span class="ev-meta-rotulo">Quando</span>
                                <span>@tipo.ResumoRecorrencia</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tipo.Local))
                            {
                                <div class="ev-meta-linha">
                                    <span class="ev-meta-rotulo">Local</span>
                                    <span>@tipo.Local</span>
                                </div>
                            }
                        </div>

                        @if (diasParaProximo.HasValue)
                        {
                            <span class="ev-proximo">
                                Próximo:
                                @if (diasParaProximo == 0)
                                {
                                    @:hoje
                                }
                                else if (diasParaProximo == 1)
                                {
                                    @:amanhã
                                }
                                else
                                {
                                    @($"{tipo.ProximaData!.Value.ToString("dd/MM", culture)} · em {diasParaProximo} dias")
                                }
                            </span>
                        }
                    </div>

                    <!-- Marcador central (desktop) -->
                    <div class="ev-ponto"><span></span></div>

                    <!-- Marco visual lateral (desktop) -->
                    <div class="ev-lateral">
                        <div class="ev-marco">
                            <span class="ev-marco-dia">
                                @(tipo.ProximaData.HasValue
                                    ? tipo.ProximaData.Value.ToString("dd", culture)
                                    : tipo.DataHora.ToString("dd", culture))
                            </span>
                            <span class="ev-marco-mes">
                                @(tipo.ProximaData.HasValue
                                    ? tipo.ProximaData.Value.ToString("MMM", culture)
                                    : tipo.DataHora.ToString("MMM", culture))
                            </span>
                            <span class="ev-marco-linha"></span>
                        </div>
                    </div>
                </div>
            }

            <div class="ev-fim" style="--ev-cor: @corFim;">
                <span class="ev-fim-ponto"></span>
                <a asp-action="Calendario" class="btn btn-outline-light px-4">Ver o calendário completo</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Mobile: um toque seleciona o card (zoom + foco).
        // Toque fora de qualquer card limpa a selecao e todos voltam a ficar legiveis.
        (function () {
            var trilha = document.querySelector('.ev-trilha');
            if (!trilha) { return; }

            // No desktop a leitura e por hover; o clique nao seleciona.
            if (window.matchMedia('(hover: hover) and (min-width: 768px)').matches) { return; }

            var blocoSelecionado = null;

            function limpar() {
                if (blocoSelecionado) {
                    blocoSelecionado.classList.remove('ev-selecionado');
                    blocoSelecionado = null;
                }
                trilha.classList.remove('ev-tem-selecao');
            }

            trilha.addEventListener('click', function (e) {
                var bloco = e.target.closest('.ev-bloco');

                // Toque fora de qualquer card: volta ao normal
                if (!bloco) {
                    limpar();
                    return;
                }

                e.preventDefault();

                // Toque no mesmo card ja selecionado: desmarca
                if (bloco === blocoSelecionado) {
                    limpar();
                    return;
                }

                if (blocoSelecionado) {
                    blocoSelecionado.classList.remove('ev-selecionado');
                }

                blocoSelecionado = bloco;
                bloco.classList.add('ev-selecionado');
                trilha.classList.add('ev-tem-selecao');
            });

            // Toque fora da trilha tambem limpa a selecao
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.ev-trilha')) {
                    limpar();
                }
            });
        })();
    </script>
}
