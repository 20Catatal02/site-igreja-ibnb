@model IBNB.ViewModels.EventosIndexViewModel

@{
    ViewData["Title"] = "Eventos";

    var corEvento = "#198754";
    var corCeia = "#facc15";
    var culture = new System.Globalization.CultureInfo("pt-BR");
}

<style>
    /* ===== Vitrine de eventos: layout alternado (scrollytelling) ===== */
    .ev-hero {
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .ev-hero h1 {
        font-weight: 800;
        letter-spacing: -.02em;
        color: #fff;
        margin-bottom: .75rem;
    }
    .ev-hero p {
        color: #9aa4ae;
        max-width: 620px;
        margin: 0 auto 1.75rem;
        font-size: 1.02rem;
    }
    .ev-acoes {
        display: inline-flex;
        gap: .6rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* Linha do "scrollytelling" */
    .ev-trilha {
        position: relative;
        padding-bottom: 2rem;
    }
    /* Linha vertical central, apenas no desktop */
    .ev-trilha::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        transform: translateX(-50%);
        background: linear-gradient(to bottom,
            rgba(25, 135, 84, 0) 0%,
            rgba(25, 135, 84, .55) 8%,
            rgba(25, 135, 84, .55) 92%,
            rgba(25, 135, 84, 0) 100%);
    }

    .ev-bloco {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        align-items: center;
        margin-bottom: 3rem;
    }

    /* Marcador na linha central */
    .ev-ponto {
        display: none;
    }

    .ev-card {
        background-color: #212529;
        border: 1px solid #3a3f45;
        border-radius: .9rem;
        padding: 1.6rem 1.7rem;
        transition: border-color .25s ease, transform .25s ease;
    }
    .ev-card:hover {
        border-color: #198754;
        transform: translateY(-3px);
    }
    .ev-card.destaque {
        border-color: #a16207;
        box-shadow: 0 0 0 1px rgba(250, 204, 21, .35) inset;
        background-image: repeating-linear-gradient(45deg,
            rgba(250, 204, 21, .05),
            rgba(250, 204, 21, .05) 8px,
            rgba(234, 179, 8, .09) 8px,
            rgba(234, 179, 8, .09) 16px);
    }

    .ev-tag {
        display: inline-block;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        padding: .22rem .6rem;
        border-radius: 999px;
        background-color: rgba(25, 135, 84, .18);
        color: #4ade80;
        border: 1px solid rgba(25, 135, 84, .5);
        margin-bottom: .7rem;
    }
    .ev-card.destaque .ev-tag {
        background-color: rgba(250, 204, 21, .16);
        color: #facc15;
        border-color: rgba(250, 204, 21, .55);
    }

    .ev-titulo {
        font-size: 1.35rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: .55rem;
        line-height: 1.25;
    }
    .ev-desc {
        color: #adb5bd;
        font-size: .93rem;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .ev-meta {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        font-size: .86rem;
        color: #ced4da;
    }
    .ev-meta-linha {
        display: flex;
        align-items: flex-start;
        gap: .5rem;
    }
    .ev-meta-icone {
        color: #198754;
        flex: 0 0 1rem;
        font-weight: 700;
    }
    .ev-card.destaque .ev-meta-icone {
        color: #facc15;
    }

    /* "Próximo" como selo */
    .ev-proximo {
        display: inline-block;
        margin-top: .9rem;
        font-size: .78rem;
        font-weight: 600;
        padding: .3rem .7rem;
        border-radius: .45rem;
        background-color: rgba(13, 110, 253, .15);
        border: 1px solid rgba(13, 110, 253, .45);
        color: #6ea8fe;
    }

    /* Painel lateral (o "vazio" do layout alternado, preenchido com um detalhe) */
    .ev-lateral {
        display: none;
    }
    /* Mobile/tablet: a data aparece dentro do card */
    .ev-data {
        text-transform: capitalize;
    }

    /* ===== Desktop: alterna esquerda / direita ===== */
    @@media (min-width: 768px) {
        .ev-bloco {
            grid-template-columns: 1fr 84px 1fr;
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }
        .ev-ponto {
            display: flex;
            justify-content: center;
            align-items: center;
            grid-column: 2;
            grid-row: 1;
        }
        .ev-ponto span {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background-color: #198754;
            box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px #3a3f45;
            transition: background-color .5s cubic-bezier(.22, .61, .36, 1), box-shadow .5s cubic-bezier(.22, .61, .36, 1), transform .5s cubic-bezier(.22, .61, .36, 1);
        }
        .ev-bloco.destaque .ev-ponto span {
            background-color: #facc15;
            box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px #a16207;
        }

        /* Blocos ímpares: card à esquerda, detalhe à direita */
        .ev-bloco:nth-of-type(odd) .ev-card { grid-column: 1; grid-row: 1; }
        .ev-bloco:nth-of-type(odd) .ev-lateral {
            grid-column: 3;
            grid-row: 1;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 1.5rem;
        }

        /* Blocos pares: card à direita, detalhe à esquerda */
        .ev-bloco:nth-of-type(even) .ev-card { grid-column: 3; grid-row: 1; }
        .ev-bloco:nth-of-type(even) .ev-lateral {
            grid-column: 1;
            grid-row: 1;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-right: 1.5rem;
        }
    }

    /* ===== Microinterações ===== */

    /* O bloco inteiro reage ao hover do card: a linha central ganha destaque
       e o ponto acende. */
    .ev-bloco {
        --ev-cor: #198754;
    }
    .ev-bloco.destaque {
        --ev-cor: #facc15;
    }

    /* Linha central com destaque suave ao passar o mouse no bloco.
       Somente no desktop: no mobile nao existe linha central, portanto
       o realce nao deve ser desenhado sobre o card. */
    .ev-bloco::after {
        content: none;
    }
    .ev-bloco:hover::after {
        content: none;
    }

    @@media (min-width: 768px) {
        .ev-bloco::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            transform: translateX(-50%) scaleY(.35);
            transform-origin: center;
            background-color: var(--ev-cor);
            opacity: 0;
            transition: opacity .6s ease, transform .6s cubic-bezier(.22, .61, .36, 1);
            pointer-events: none;
        }
        .ev-bloco:hover::after {
            content: "";
            opacity: .38;
            transform: translateX(-50%) scaleY(1);
        }
    }

    /* Ponto central acendendo: brilho curto e suave */
    .ev-bloco:hover .ev-ponto span {
        background-color: #4ade80;
        box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px var(--ev-cor), 0 0 10px 1px rgba(74, 222, 128, .35);
        transform: scale(1.1);
    }
    .ev-bloco.destaque:hover .ev-ponto span {
        background-color: #fde047;
        box-shadow: 0 0 0 5px #1b1f23, 0 0 0 6px #a16207, 0 0 10px 1px rgba(250, 204, 21, .35);
    }

    /* Card: elevação e borda suave (transição longa = luz mais calma) */
    .ev-card {
        transition:
            border-color .55s cubic-bezier(.22, .61, .36, 1),
            transform .55s cubic-bezier(.22, .61, .36, 1),
            box-shadow .55s cubic-bezier(.22, .61, .36, 1);
    }
    .ev-bloco:hover .ev-card {
        border-color: var(--ev-cor);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, .38);
    }

    /* Marco lateral também responde */
    .ev-bloco:hover .ev-marco-dia {
        color: #fff;
    }
    .ev-bloco:hover .ev-marco-linha {
        width: 56px;
        background-color: var(--ev-cor);
        opacity: .85;
    }

    /* ===== Marco visual lateral ===== */
    .ev-marco {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .1rem;
        user-select: none;
    }
    .ev-marco-dia {
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1;
        color: #495057;
        letter-spacing: -.03em;
        transition: color .45s ease;
    }
    .ev-marco-mes {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #6c757d;
    }
    .ev-marco-linha {
        display: block;
        width: 32px;
        height: 2px;
        margin-top: .55rem;
        border-radius: 2px;
        background-color: #343a40;
        opacity: .7;
        transition: width .5s cubic-bezier(.22, .61, .36, 1), background-color .45s ease, opacity .45s ease;
    }

    /* Rótulos de metadados */
    .ev-meta-rotulo {
        flex: 0 0 3.6rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: #6c757d;
        padding-top: .1rem;
    }
    .ev-agora {
        margin-left: .35rem;
        font-size: .78rem;
        font-weight: 700;
        color: #4ade80;
    }

    /* ===== Mobile: zoom sutil ao tocar no card ===== */
    @@media (max-width: 767.98px) {
        .ev-card {
            transition:
                transform .28s cubic-bezier(.22, .61, .36, 1),
                border-color .28s ease,
                box-shadow .28s ease;
        }
        .ev-card:active {
            transform: scale(1.015);
            border-color: var(--ev-cor);
            box-shadow: 0 6px 18px rgba(0, 0, 0, .35);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ev-card,
        .ev-bloco::after,
        .ev-marco-dia,
        .ev-marco-linha,
        .ev-ponto span {
            transition: none;
        }
        .ev-bloco:hover .ev-card {
            transform: none;
        }
    }

    .ev-vazio {
        text-align: center;
        padding: 4rem 1rem;
        color: #9aa4ae;
    }
</style>

<div class="container">

    <!-- Cabeçalho -->
    <section class="ev-hero">
        <h1>Eventos da Igreja</h1>
        <p>
            Conheça as programações que acontecem em nossa igreja.
            As próximas programações dos próximos 15 dias, cada uma exibida uma única vez.
        </p>
        <div class="ev-acoes">
            <a asp-action="Calendario" class="btn btn-primary px-4">Calendário</a>
            @if (Model.PodeCriarEvento)
            {
                <a asp-action="Create" class="btn btn-success px-4">Novo Evento</a>
            }
        </div>
        @if (!Model.PodeCriarEvento)
        {
            <div class="mt-3">
                <small class="text-white-50">
                    Para adicionar um novo evento é necessário
                    <a asp-area="Identity" asp-page="/Account/Login" class="link-light text-decoration-underline">entrar</a>
                    com uma conta cadastrada.
                </small>
            </div>
        }
    </section>

    @if (!Model.Tipos.Any())
    {
        <div class="ev-vazio">
            <h4 class="text-white">Nenhuma programação cadastrada</h4>
            <p class="mb-0">Assim que os eventos forem adicionados, eles aparecerão aqui.</p>
        </div>
    }
    else
    {
        <div class="ev-trilha">
            @foreach (var tipo in Model.Tipos)
            {
                var diasParaProximo = tipo.ProximaData.HasValue
                    ? (tipo.ProximaData.Value.Date - Model.Hoje.Date).Days
                    : (int?)null;

                <div class="ev-bloco @(tipo.Destaque ? "destaque" : "")">

                    <!-- Card do evento -->
                    <div class="ev-card @(tipo.Destaque ? "destaque" : "")">
                        <span class="ev-tag">@tipo.Tag</span>

                        <h3 class="ev-titulo">@tipo.Titulo</h3>

                        @if (!string.IsNullOrWhiteSpace(tipo.Descricao))
                        {
                            <p class="ev-desc">@tipo.Descricao</p>
                        }
                        else
                        {
                            <p class="ev-desc fst-italic text-white-50">
                                Uma programação especial da nossa igreja.
                            </p>
                        }

                        <div class="ev-meta">
                            <div class="ev-meta-linha">
                                <span class="ev-meta-rotulo">Data</span>
                                <span class="ev-data">
                                    @tipo.DataHora.ToString("dddd, dd 'de' MMMM", culture)
                                    @if (tipo.DataHora.Date == Model.Hoje.Date)
                                    {
                                        <strong class="ev-agora">hoje</strong>
                                    }
                                    else if (tipo.DataHora.Date == Model.Hoje.Date.AddDays(1))
                                    {
                                        <strong class="ev-agora">amanhã</strong>
                                    }
                                </span>
                            </div>
                            <div class="ev-meta-linha">
                                <span class="ev-meta-rotulo">Horário</span>
                                <span>@tipo.ResumoRecorrencia</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tipo.Local))
                            {
                                <div class="ev-meta-linha">
                                    <span class="ev-meta-rotulo">Local</span>
                                    <span>@tipo.Local</span>
                                </div>
                            }
                        </div>

                        @if (diasParaProximo.HasValue)
                        {
                            <span class="ev-proximo">
                                Próximo:
                                @if (diasParaProximo == 0)
                                {
                                    @:hoje
                                }
                                else if (diasParaProximo == 1)
                                {
                                    @:amanhã
                                }
                                else
                                {
                                    @($"{tipo.ProximaData!.Value.ToString("dd/MM", culture)} · em {diasParaProximo} dias")
                                }
                            </span>
                        }
                    </div>

                    <!-- Marcador central (desktop) -->
                    <div class="ev-ponto"><span></span></div>

                    <!-- Marco visual lateral (desktop) -->
                    <div class="ev-lateral">
                        <div class="ev-marco">
                            <span class="ev-marco-dia">
                                @(tipo.ProximaData.HasValue
                                    ? tipo.ProximaData.Value.ToString("dd", culture)
                                    : tipo.DataHora.ToString("dd", culture))
                            </span>
                            <span class="ev-marco-mes">
                                @(tipo.ProximaData.HasValue
                                    ? tipo.ProximaData.Value.ToString("MMM", culture)
                                    : tipo.DataHora.ToString("MMM", culture))
                            </span>
                            <span class="ev-marco-linha"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
